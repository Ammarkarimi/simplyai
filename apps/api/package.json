{
  "name": "@simplyai/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/websockets": "^11.1.6",
    "@simplyai/ai": "workspace:*",
    "@simplyai/core": "workspace:*",
    "@simplyai/db": "workspace:*",
    "@simplyai/engine": "workspace:*",
    "@simplyai/sdk": "workspace:*",
    "@simplyai/shared": "workspace:*",
    "bullmq": "^5.58.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "papaparse": "^5.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "3.25.76",
    "express": "^5.1.0",
    "@simplyai/nodes": "workspace:*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/papaparse": "^5.3.16",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.7",
    "@swc/core": "^1.13.5",
    "vitest": "^3.2.4"
  }
}
