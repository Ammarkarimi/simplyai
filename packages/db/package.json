{
  "name": "@simplyai/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.json",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env -- node dist/seed/run.js",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "node dist/seed/run.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@simplyai/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "dotenv-cli": "^8.0.0"
  }
}
