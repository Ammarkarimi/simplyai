# ── Core ───────────────────────────────────────────────
NODE_ENV=development
# Public URL of the web app (used for links in emails, OAuth redirects, form/chat pages)
APP_URL=http://localhost:3000
# Public URL of the API (webhooks are served from here)
API_URL=http://localhost:4000
# Where the browser connects for WebSocket updates
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Internal URL the Next.js server uses to proxy /api to the API service
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simplyai?schema=public
REDIS_URL=redis://localhost:6379

# 32-byte key, generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Used to sign WebSocket tokens and OAuth state, generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Workers ────────────────────────────────────────────
WORKER_CONCURRENCY=10
# Allow HTTP nodes to call private/loopback addresses (keep false in production)
ALLOW_PRIVATE_NETWORK=false
CODE_SANDBOX_TIMEOUT_MS=10000
CODE_SANDBOX_MEMORY_MB=128
EXECUTION_MAX_PAYLOAD_BYTES=1048576

# ── Storage (S3 compatible). Leave S3_BUCKET empty to use local disk ──
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Email (leave SMTP_HOST empty to print emails to the API log) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="SimplyAI <no-reply@simplyai.local>"

# ── Google sign-in (optional) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Billing with Stripe (optional) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Platform admin bootstrap: users with these emails become platform admins ──
PLATFORM_ADMIN_EMAILS=admin@simplyai.dev
